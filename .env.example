# Supabase Public Configuration (obtener en Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (opcional para migraciones y scripts administrativos seguros de backend)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Google Places API (New) Key (para el agente de prospección Lola)
# Si no está configurada, Lola utiliza el motor local de alta fidelidad como fallback automático.
GOOGLE_MAPS_API_KEY=your-google-places-api-key-here
